# ================================================================
# ENGIDA PLATFORM ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure for your environment
# ================================================================

# --- Database Configuration ---
# Local PostgreSQL instance used by the backend on the host:
DATABASE_URL=postgresql://engida:1921@localhost:5433/engida
# Docker Compose backend URL for the same host database:
DOCKER_DATABASE_URL=postgresql://engida:1921@host.docker.internal:5433/engida

# --- Backend API Service (Canonical Port: 3000) ---
PORT=3000
NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ACCESS_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=http://localhost:3001

# --- AI Service Microservice (Port 8000) ---
AI_SERVICE_URL=http://localhost:8000

# --- Frontend Client (Port 3001) ---
# Browser-accessible backend URL:
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_AI=false

# --- Cloudinary (Property Image Storage) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
