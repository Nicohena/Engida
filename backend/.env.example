# ================================================================
# ENGIDA BACKEND ENVIRONMENT CONFIGURATION
# ================================================================

# Canonical Server Port
PORT=3000
NODE_ENV=development

# --- PostgreSQL Database Configuration ---
# Option 1: Full connection string (Takes precedence if provided)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engida_db
# Docker Compose internal URL:
# DATABASE_URL=postgresql://engida:engida@postgres:5432/engida

# Option 2: Discrete connection parameters (Fallback if DATABASE_URL is not set)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=engida_db
DATABASE_SYNCHRONIZE=false

# --- JWT Secrets & Expiration ---
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-of-at-least-32-characters
JWT_REFRESH_EXPIRATION=7d

# --- CORS & Client Configuration ---
# Comma separated list of allowed browser origins.
FRONTEND_URL=http://localhost:3001
# BACKEND_URL=http://localhost:3000

# --- Cookie Settings (refresh token cookie) ---
# Use "none" + COOKIE_SECURE=true when the API and the app live on different sites.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# --- Google Sign-In (OpenID Connect) ---
# Create an OAuth 2.0 Web Client in the Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional - defaults to ${BACKEND_URL}/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Optional - restrict sign-in to a single Google Workspace domain (e.g. engida.com)
# GOOGLE_ALLOWED_HOSTED_DOMAIN=

# --- AI Service Microservice URL ---
# Local host machine:
AI_SERVICE_URL=http://localhost:8000
# Docker internal network:
# AI_SERVICE_URL=http://ai-service:8000

# --- Cloudinary Configuration (Property Image Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
