# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engida_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=engida_db
DATABASE_SYNCHRONIZE=false

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Cookie Settings
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Google Sign-In (OpenID Connect)
# The redirect URI must exactly match an "Authorized redirect URI" configured
# in the Google Cloud Console. Use the port your backend really listens on
# (docker-compose runs the backend on 3000).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# AI Service Microservice URL
AI_SERVICE_URL=http://localhost:8000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
